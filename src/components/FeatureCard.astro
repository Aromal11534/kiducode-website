---
import FeatureIcon from "./FeatureIcon.astro";

interface Props {
  title: string;
  description: string;
  icon?: string;
  iconName?: string;
}

const { title, description, icon = ">", iconName } = Astro.props;
---

<article class="group surface-muted rounded-xl p-6">
  <div class="mb-4 inline-flex text-slate-300 transition-colors duration-200 group-hover:text-brand-soft">
    {iconName ? <FeatureIcon name={iconName} /> : <span class="font-mono text-sm">{icon}</span>}
  </div>
  <h3 class="text-base font-semibold text-white">{title}</h3>
  <p class="mt-2 text-sm leading-6 text-slate-400">{description}</p>
</article>
