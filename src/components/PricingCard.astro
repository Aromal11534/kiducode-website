---
import Button from "./Button.astro";

interface Detail {
  label: string;
  value: string;
}

interface Props {
  tier: string;
  price: string;
  priceSuffix?: string;
  bestFor: string;
  details: Detail[];
  includes?: string;
  footnote?: string;
  badge?: string;
  cta: string;
  href: string;
  ctaVariant?: "primary" | "secondary";
}

const {
  tier,
  price,
  priceSuffix,
  bestFor,
  details,
  includes,
  footnote,
  badge,
  cta,
  href,
  ctaVariant = "secondary",
} = Astro.props;

const isPopular = badge !== undefined;
---

<article class:list={[
  "surface-panel group relative flex h-full flex-col rounded-xl p-6 transition-all duration-300",
  "hover:-translate-y-1 hover:border-brand-soft/30 hover:shadow-[0_0_30px_rgba(125,223,138,0.1)]",
  isPopular ? "border-brand-soft/20 shadow-[0_0_20px_rgba(125,223,138,0.05)]" : ""
]}>
  {isPopular && (
    <div class="absolute -inset-[1px] -z-10 rounded-xl bg-gradient-to-b from-brand-soft/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
  )}

  <div class="flex min-h-7 items-start justify-between gap-3">
    <h3 class="text-xl font-semibold text-white">{tier}</h3>
    {badge && (
      <span class="rounded-full border border-brand/30 bg-brand/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-brand-soft">
        {badge}
      </span>
    )}
  </div>

  <div class="mt-3 flex items-end gap-1.5">
    <p class="text-[28px] font-semibold leading-none tracking-tight text-white">{price}</p>
    {priceSuffix && <span class="pb-0.5 text-sm text-slate-400">{priceSuffix}</span>}
  </div>
  <p class="mt-3 min-h-10 text-sm leading-5 text-slate-400">{bestFor}</p>

  <div class="mt-6 flex-1">
    {includes && (
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.16em] text-brand-soft">
        {includes}
      </p>
    )}
    <dl class="grid grid-cols-2 gap-x-6 gap-y-5">
      {details.map((detail) => (
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-soft/70">
            {detail.label}
          </dt>
          <dd class="mt-1.5 text-[13px] font-medium leading-5 text-slate-200">{detail.value}</dd>
        </div>
      ))}
    </dl>
    {footnote && <p class="mt-5 text-xs leading-5 text-slate-500">{footnote}</p>}
  </div>

  <div class="mt-auto pt-7">
    <Button href={href} variant={ctaVariant} className="w-full justify-center">{cta}</Button>
  </div>
</article>
