---
import Button from "../components/Button.astro";
import ContactForm from "../components/ContactForm.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact KiduCode — Get in Touch with the Kerala AI Coding Team"
  description="Contact the KiduCode team for project inquiries, security reports, enterprise collaboration, or open-source contributions. Reach us at team@kiducode.com."
>
  <section class="section-grid py-16 lg:py-24">
    <SectionHeading
      eyebrow="Contact"
      title="Get in touch with KiduCode."
      description="Use the addresses below for project questions, security topics, or early collaboration conversations. You can also use the form below to reach us directly."
      as="h1"
    />
  </section>

  <section class="section-grid pb-20">
    <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="surface-panel rounded-[28px] p-6">
        <h2 class="text-xl font-semibold text-white">Contact channels</h2>
        <ul class="mt-5 space-y-4 text-sm text-slate-300">
          <li>
            General: <a class="text-brand-soft" href="mailto:team@kiducode.com">team@kiducode.com</a>
          </li>
          <li>
            GitHub: <a class="text-brand-soft" href={site.githubUrl} target="_blank" rel="noreferrer">{site.githubUrl}</a>
          </li>
        </ul>
        <div class="mt-6">
          <Button href={site.githubUrl} external={true}>Open GitHub</Button>
        </div>
      </article>

      <article class="surface-panel rounded-[28px] p-6">
        <h2 class="text-xl font-semibold text-white">Contact form</h2>
        <ContactForm
          recipient={site.contactEmail}
          subject="KiduCode project enquiry"
          messagePlaceholder="Tell us what you are building with KiduCode."
        />
      </article>
    </div>
  </section>
</BaseLayout>
