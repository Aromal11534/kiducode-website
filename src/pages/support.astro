---
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="KiduCode Support — Help, Troubleshooting & Vercel Integration"
  description="Get support for KiduCode Cloud, CLI, and our Vercel integration. Reach out for troubleshooting, billing, or general help."
>
  <section class="section-grid py-16 lg:py-24">
    <SectionHeading
      eyebrow="Support"
      title="KiduCode Support"
      description="Need help with the KiduCode CLI, Cloud Console, or Vercel integration? Reach out using the channels below."
      as="h1"
    />
  </section>

  <section class="section-grid pb-20">
    <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="surface-panel rounded-[28px] p-6">
        <h2 class="text-xl font-semibold text-white">Support channels</h2>
        <ul class="mt-5 space-y-4 text-sm text-slate-300">
          <li>
            General: <a class="text-brand-soft" href="mailto:team@kiducode.com">team@kiducode.com</a>
          </li>
          <li>
            GitHub: <a class="text-brand-soft" href={site.githubUrl} target="_blank" rel="noreferrer">{site.githubUrl}</a>
          </li>
        </ul>
        <div class="mt-6">
          <Button href={site.githubUrl} external={true}>Open GitHub</Button>
        </div>
      </article>

      <article class="surface-panel rounded-[28px] p-6">
        <h2 class="text-xl font-semibold text-white">Support form</h2>
        <form class="mt-5 grid gap-4">
          <label class="grid gap-2 text-sm text-slate-300">
            Name
            <input
              type="text"
              placeholder="Your name"
              class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none ring-0 placeholder:text-slate-500"
            />
          </label>
          <label class="grid gap-2 text-sm text-slate-300">
            Email
            <input
              type="email"
              placeholder="you@example.com"
              class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none ring-0 placeholder:text-slate-500"
            />
          </label>
          <label class="grid gap-2 text-sm text-slate-300">
            Message
            <textarea
              rows="5"
              placeholder="Tell us what you are building with KiduCode."
              class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none ring-0 placeholder:text-slate-500"
            ></textarea>
          </label>
          <button type="submit" class="mt-4 rounded-xl bg-brand-soft px-4 py-3 text-sm font-semibold text-black transition-transform hover:scale-105">
            Send Message
          </button>
        </form>
      </article>
    </div>
  </section>
</BaseLayout>
